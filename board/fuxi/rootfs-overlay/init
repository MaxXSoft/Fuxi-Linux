#!/bin/sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export TERM=vt100

fail()
{
  echo "FUXI_LINUX_SMOKE_FAIL: $*"
  exec /sbin/fuxi-finish 1
}

mount -t devtmpfs devtmpfs /dev || fail "mount /dev"
mount -t proc proc /proc || fail "mount /proc"
mount -t sysfs sysfs /sys || fail "mount /sys"
mkdir -p /tmp /run /root || fail "create runtime directories"
mount -t tmpfs -o size=8m tmpfs /tmp || fail "mount /tmp"

echo "FUXI_LINUX_INIT: $(uname -m)"
if grep -q 'fuxi.interactive=1' /proc/cmdline; then
  echo "Interactive mode. Run fuxi-smoke manually, then fuxi-finish 0 to exit."
  exec /bin/sh
fi

printf 'Fuxi userspace filesystem test\n' >/tmp/original || fail "write tmpfs"
cp /tmp/original /tmp/copy || fail "copy tmpfs"
cmp /tmp/original /tmp/copy || fail "compare tmpfs"
/usr/bin/fuxi-smoke || fail "processor/userspace checks"
echo "FUXI_LINUX_SMOKE_PASS"
exec /sbin/fuxi-finish 0
